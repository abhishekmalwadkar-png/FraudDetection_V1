# =============================================================
# Apex Trust Commercial Bank - Environment Configuration
# =============================================================

# Application Environment (production / development)
APP_ENV=production
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_postgres_password_here
DB_NAME=bank_fraud_portal

# Database Connection Pool Tuning
DB_POOL_MIN_CACHED=5
DB_POOL_MAX_CACHED=15
DB_POOL_MAX_CONNECTIONS=20

# pgAdmin 4 Connection Credentials
PGADMIN_HOST=localhost
PGADMIN_PORT=5432
PGADMIN_USER=postgres
PGADMIN_PASSWORD=your_pgadmin_password_here
PGADMIN_DEFAULT_DATABASE=bank_fraud_portal

# Portal WSGI Server Configuration
PORTAL_HOST=127.0.0.1
PORTAL_PORT=5050
SERVER_THREADS=16
SERVER_CONNECTION_LIMIT=200

# Security & Governance
# Optional API Key for Process Studio RPA webhooks (leave empty for open local dev)
API_SECRET_KEY=
# SQL Query Console in Web UI (true / false)
ENABLE_SQL_CONSOLE=true
